# Copie para .env.local (dev) e cadastre as mesmas variáveis no Vercel:
# Project → Settings → Environment Variables.
# Só precisa preencher os provedores que for usar. Os que ficarem vazios aparecem como "sem chave" no app.

# Groq — https://console.groq.com/keys (grátis, muito rápido)
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys (modelos com sufixo :free)
OPENROUTER_API_KEY=

# Nous Portal — https://portal.nousresearch.com
NOUS_API_KEY=
# NOUS_BASE_URL=https://inference-api.nousresearch.com/v1

# NVIDIA NIM — https://build.nvidia.com (créditos grátis)
NVIDIA_API_KEY=

# Mistral — https://console.mistral.ai/api-keys (plano Experiment grátis)
MISTRAL_API_KEY=

# AnyAPI — endpoint compatível com OpenAI. Informe a base URL exata do painel (termina em /v1).
ANYAPI_API_KEY=
ANYAPI_BASE_URL=

# OrcaRouter — endpoint compatível com OpenAI. Informe a base URL exata do painel (termina em /v1).
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=

# Seu modelo treinado (fine-tune), qualquer endpoint compatível com OpenAI.
# Ex.: Ollama exposto por Cloudflare Tunnel → https://xxxx.trycloudflare.com/v1 (a chave pode ser qualquer texto)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODELS=meu-estilo

# Opcional: sobrescrever a lista de modelos de qualquer provedor (ids separados por vírgula)
# GROQ_MODELS=qwen/qwen3.6-27b,openai/gpt-oss-120b
# ORCAROUTER_MODELS=

# Opcional: áudio e print (aba Pergunta/Afirmação e Conversa).
# Transcrição usa o Whisper do Groq (precisa de GROQ_API_KEY).
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Leitura de print usa um modelo de visão. Padrão: Mistral (mistral-small-latest) ou Groq (llama-4-scout).
# Os ids mudam com o tempo; se der erro, defina o provedor e o modelo aqui.
# VISION_PROVIDER=mistral
# VISION_MODEL=mistral-small-latest

# Opcional: senha simples para impedir que estranhos gastem sua cota no domínio público.
# Se definida, o app pede essa senha uma vez e envia no header x-app-password.
APP_PASSWORD=
